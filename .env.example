# ================================
# REPLAI Environment Variables
# ================================
# Скопируйте этот файл в .env и заполните реальными значениями
# cp .env.example .env

# ================================
# SERVER CONFIGURATION
# ================================
PORT=3000
NODE_ENV=development

# ================================
# AI PROVIDER
# ================================
# Получите бесплатный ключ на: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ================================
# ADMIN AUTHENTICATION
# ================================
# Пароль для входа в админ-панель (admin@replai.com)
ADMIN_PASSWORD=admin123

# ================================
# INSTAGRAM OAUTH 2.0 (Опционально)
# ================================
# Создайте Instagram App на: https://developers.facebook.com/apps
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token

# ================================
# TELEGRAM BOT (Опционально)
# ================================
# Создайте бота через @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ================================
# WHATSAPP BUSINESS API (Опционально)
# ================================
# Получите через Meta Business Manager
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# ================================
# NGROK (Для тестирования webhooks)
# ================================
# Установите ngrok: https://ngrok.com/download
# Запустите: ngrok http 3000
NGROK_URL=https://your-subdomain.ngrok-free.app

# ================================
# DEVELOPMENT
# ================================
# Для отладки (оставьте пустым для production)
DEBUG=true
LOG_LEVEL=info
