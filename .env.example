# Groq API key for AI responses. Find in .env as GROQ_API_KEY.
GROQ_API_KEY=

# AI provider name, usually groq. Find in .env as AI_PROVIDER.
AI_PROVIDER=

# HTTP port for local or platform runtime. Railway sets PORT automatically.
PORT=

# Telegram bot token from BotFather. Find in .env as TELEGRAM_BOT_TOKEN.
TELEGRAM_BOT_TOKEN=

# Twilio Account SID from Twilio Console. Find in .env as TWILIO_ACCOUNT_SID.
TWILIO_ACCOUNT_SID=

# Twilio Auth Token from Twilio Console. Find in .env as TWILIO_AUTH_TOKEN.
TWILIO_AUTH_TOKEN=

# Twilio WhatsApp sender phone, for example whatsapp:+14155238886. Find in .env as TWILIO_PHONE_NUMBER.
TWILIO_PHONE_NUMBER=

# Instagram app ID from Meta App Dashboard. Find in .env as INSTAGRAM_APP_ID.
INSTAGRAM_APP_ID=

# Instagram app secret from Meta App Dashboard. Find in .env as INSTAGRAM_APP_SECRET.
INSTAGRAM_APP_SECRET=

# Instagram OAuth redirect URI for this deployment. Find in .env as INSTAGRAM_REDIRECT_URI.
INSTAGRAM_REDIRECT_URI=

# Instagram long-lived access token if using manual token connection. Find in .env as INSTAGRAM_ACCESS_TOKEN.
INSTAGRAM_ACCESS_TOKEN=

# Instagram user ID from Meta Graph API. Find in .env as INSTAGRAM_USER_ID.
INSTAGRAM_USER_ID=

# Instagram username for dashboard display. Find in .env as INSTAGRAM_USERNAME.
INSTAGRAM_USERNAME=

# WhatsApp Cloud API access token from Meta. Find in .env as WHATSAPP_ACCESS_TOKEN.
WHATSAPP_ACCESS_TOKEN=

# WhatsApp Cloud API phone number ID from Meta. Find in .env as WHATSAPP_PHONE_ID.
WHATSAPP_PHONE_ID=

# Optional TikTok access token for current stub. Find in .env as TIKTOK_ACCESS_TOKEN.
TIKTOK_ACCESS_TOKEN=

# Shared webhook verify token for Meta webhook validation. Find in .env as WEBHOOK_VERIFY_TOKEN.
WEBHOOK_VERIFY_TOKEN=

# Optional Instagram-specific webhook verify token. Find in .env as INSTAGRAM_WEBHOOK_VERIFY_TOKEN.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Google OAuth client ID only if still using legacy docs or UI. Find in .env as GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Google OAuth client secret only if still using legacy docs or UI. Find in .env as GOOGLE_CLIENT_SECRET.
GOOGLE_CLIENT_SECRET=

# Google OAuth redirect URI (auto-generated but can be overridden). Find in .env as GOOGLE_REDIRECT_URI.
GOOGLE_REDIRECT_URI=
