{
  "name": "business-chatbot",
  "version": "1.0.0",
  "description": "Multi-platform AI chatbot for business inquiries",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node server-new.js",
    "start:free": "node index-free.js",
    "start:web": "node server.js",
    "dev": "node --watch server-new.js",
    "dev:free": "node --watch index-free.js",
    "dev:web": "node --watch server.js",
    "build": "npx prisma generate && npx prisma migrate deploy",
    "postinstall": "npx prisma generate"
  },
  "keywords": [
    "chatbot",
    "ai",
    "telegram",
    "groq",
    "llama",
    "web"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "crypto": "^1.0.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.2.1",
    "prisma": "^5.22.0",
    "twilio": "^6.0.2"
  }
}
